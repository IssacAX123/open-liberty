-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

Bundle-Name: Model Context Protocol Microprofile Telemetry
Bundle-SymbolicName: io.openliberty.mcp.internal.mptelemetry
Bundle-Description: Open Liberty Model Context Protocol Microprofile Telemetry, version ${bVersion}

javac.source: 17
javac.target: 17

WS-TraceGroup: MCP

Private-Package: \
	io.opentelemetry.semconv.incubating

Import-Package: \
	!io.openliberty.mcp.internal.monitor,\
	!io.openliberty.mcp.internal.monitor.metrics,\
	!com.ibm.ws.connectionpool.monitor.metrics,\
	io.opentelemetry.api.common;version="[1.2,3)",\
	io.openliberty.microprofile.telemetry.internal.common.resources,\
	javax.annotation;version="[1.2,2)",\
	javax.enterprise.event;version="[1.1,3)",\
	javax.enterprise.inject;version="[1.1,3)",\
	javax.enterprise.inject.spi;version="[1.1,3)",\
	javax.enterprise.context;version="[1.1.0,3)",\
	org.eclipse.microprofile.rest.client; version="[1.0.0,3.0.0)",\
	org.eclipse.microprofile.rest.client.spi; version="[1.0.0,3.0.0)",\
	org.eclipse.microprofile.config; version="[1.0.0,3.0.0)",\
	*

Export-Package: \
	io.openliberty.mcp.internal.mptelemetry
	

-dsannotations-inherit: true
-dsannotations: \
	io.openliberty.mcp.internal.mptelemetry.MPTelemetryMcpMetricsAdapterImpl
	
-buildpath: \
	com.ibm.ws.org.osgi.annotation.versioning;version=latest,\
	com.ibm.ws.logging.core;version=latest,\
	com.ibm.ws.cdi.interfaces;version=latest,\
	com.ibm.wsspi.org.osgi.service.component.annotations;version=latest,\
	com.ibm.websphere.org.eclipse.microprofile.config.1.3,\
	com.ibm.websphere.org.osgi.core;version=latest,\
	com.ibm.ws.container.service;version=latest,\
	com.ibm.ws.kernel.boot.core;version=latest,\
	com.ibm.websphere.javaee.jaxrs.2.0;version=latest,\
	com.ibm.websphere.javaee.servlet.3.1;version=latest,\
	com.ibm.websphere.javaee.annotation.1.2;version=latest,\
	com.ibm.websphere.javaee.interceptor.1.2;version=latest,\
	com.ibm.websphere.javaee.cdi.1.2;version=latest,\
	com.ibm.websphere.org.eclipse.microprofile.rest.client.1.1;version=latest,\
	io.openliberty.org.jboss.resteasy.common;version=latest,\
	io.openliberty.microprofile.telemetry.internal.common;version=latest,\
	io.openliberty.microprofile.telemetry.logging.internal.common;version=latest,\
	io.openliberty.io.opentelemetry.2.0;version=latest,\
	com.ibm.ws.kernel.boot.common;version=latest,\
	io.openliberty.mcp.internal;version=latest,\
	io.openliberty.mcp.internal.monitor;version=latest,\
	io.opentelemetry.instrumentation:opentelemetry-resources;version='2.1.0.alpha',\
	com.ibm.ws.connectionpool.monitor;version=latest,\
	com.ibm.ws.kernel.service,\
	io.openliberty.io.opentelemetry.internal.2.1,\
	io.opentelemetry.semconv:opentelemetry-semconv-incubating;version='1.40.0.alpha'